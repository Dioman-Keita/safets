{
  "name": "safets",
  "version": "0.8.0",
  "description": "Finds common runtime crashes TypeScript can't detect",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "safets": "./src/index.ts"
  },
  "scripts": {
    "doctor": "ts-node --esm src/index.ts doctor",
    "fix": "ts-node --esm src/index.ts fix",
    "debt": "ts-node --esm src/index.ts debt",
    "baseline": "ts-node --esm src/index.ts baseline"
  },
  "keywords": [
    "typescript",
    "static-analysis",
    "runtime-crashes",
    "linter",
    "safety"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.9.0"
  }
}
